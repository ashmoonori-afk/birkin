{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://birkin.dev/schemas/cron-job-v1.schema.json",
  "title": "Birkin cron job",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "hour",
    "minute",
    "type",
    "value",
    "enabled",
    "deliver_chat_id",
    "created",
    "last_run",
    "schedule",
    "next_run"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "hour": {"type": "integer", "minimum": 0, "maximum": 23},
    "minute": {"type": "integer", "minimum": 0, "maximum": 59},
    "type": {"type": "string", "enum": ["prompt", "shell", "monitor", "briefing"]},
    "value": {"type": "string"},
    "enabled": {"type": "boolean"},
    "deliver_chat_id": {"type": ["string", "null"]},
    "created": {"type": "string", "format": "date-time"},
    "last_run": {"type": ["string", "null"], "format": "date-time"},
    "schedule": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "display", "hour", "minute"],
          "properties": {
            "kind": {"const": "daily"},
            "display": {"type": "string"},
            "hour": {"type": "integer", "minimum": 0, "maximum": 23},
            "minute": {"type": "integer", "minimum": 0, "maximum": 59}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "display", "minutes"],
          "properties": {
            "kind": {"const": "interval"},
            "display": {"type": "string"},
            "minutes": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "display", "run_at"],
          "properties": {
            "kind": {"const": "once"},
            "display": {"type": "string"},
            "run_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "display", "expr"],
          "properties": {
            "kind": {"const": "cron"},
            "display": {"type": "string"},
            "expr": {"type": "string"}
          },
          "additionalProperties": false
        }
      ]
    },
    "next_run": {"type": ["string", "null"], "format": "date-time"},
    "monitor_url": {"type": ["string", "null"]},
    "monitor_script": {"type": ["string", "null"]},
    "max_bytes": {"type": "integer", "minimum": 1, "maximum": 262144}
  },
  "allOf": [
    {
      "if": {
        "properties": {"type": {"const": "monitor"}},
        "required": ["type"]
      },
      "then": {
        "required": ["monitor_url", "monitor_script", "max_bytes"],
        "oneOf": [
          {
            "properties": {
              "monitor_url": {"type": "string", "minLength": 1},
              "monitor_script": {"type": "null"}
            }
          },
          {
            "properties": {
              "monitor_url": {"type": "null"},
              "monitor_script": {"type": "string", "minLength": 1}
            }
          }
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["monitor_url"]},
            {"required": ["monitor_script"]},
            {"required": ["max_bytes"]}
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
