{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://birkin.dev/schemas/config-v1.schema.json",
  "title": "Birkin configuration",
  "x-birkin-version": 1,
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "api_keys": {"type": "array", "items": {"type": "string"}},
    "cli_command": {"type": "array", "items": {"type": "string"}},
    "command_allowlist": {"type": "array", "items": {"type": "string"}},
    "extra_skill_dirs": {"type": "array", "items": {"type": "string"}},
    "disabled_tools": {"type": "array", "items": {"type": "string"}},
    "gateway_allowed_tools": {"type": "array", "items": {"type": "string"}},
    "workspace_roots": {"type": "array", "items": {"type": "string"}},
    "auto_approve": {"type": "array", "items": {"type": "string"}},
    "harness_auto_approve": {"type": "array", "items": {"type": "string"}},
    "max_tokens": {"type": "integer", "minimum": 1},
    "max_turns": {"type": "integer", "minimum": 1},
    "context_window": {"type": "integer", "minimum": 1},
    "web_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "web_external_url": {"type": "string"},
    "gateway_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "morpheus_hour": {"type": "integer", "minimum": 0, "maximum": 23},
    "morpheus_minute": {"type": "integer", "minimum": 0, "maximum": 59},
    "nightly_hour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23,
      "deprecated": true,
      "x-replaced-by": "morpheus_hour"
    },
    "nightly_minute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 59,
      "deprecated": true,
      "x-replaced-by": "morpheus_minute"
    },
    "cli_access": {
      "type": "string",
      "enum": ["workspace", "full"]
    },
    "sandbox": {
      "type": "object",
      "description": "Defaults for isolated worktree or Docker jobs; repositories may override them in .birkin/sandbox.json.",
      "x-description-ko": "격리된 worktree 또는 Docker 작업의 기본값이며 저장소의 .birkin/sandbox.json에서 재정의할 수 있습니다.",
      "properties": {
        "backend": {"type": "string", "enum": ["worktree", "docker"]},
        "image": {"type": "string"},
        "setup": {"type": "array", "items": {"type": "string"}},
        "env_allowlist": {"type": "array", "items": {"type": "string"}},
        "network": {"type": "string", "enum": ["off", "allowlist"]},
        "network_allowlist": {"type": "array", "items": {"type": "string"}},
        "write_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "memory_scope": {
      "type": "string",
      "enum": ["user", "project", "organization", "agent", "workflow"],
      "description": "Owning scope used for memory writes.",
      "x-description-ko": "메모리 쓰기에 사용하는 소유 범위입니다."
    },
    "memory_visible_scopes": {
      "type": "array",
      "items": {"type": "string", "enum": ["user", "project", "organization", "agent", "workflow"]},
      "description": "Memory scopes this agent may read; omitted scopes fail closed.",
      "x-description-ko": "이 에이전트가 읽을 수 있는 메모리 범위이며 생략된 범위는 닫힌 상태로 거부됩니다."
    },
    "memory_default_trust": {
      "type": "string",
      "enum": ["untrusted", "low", "medium", "high"],
      "description": "Trust assigned to memory sources without an explicit mapping.",
      "x-description-ko": "명시적 매핑이 없는 메모리 출처에 적용하는 신뢰 수준입니다."
    },
    "memory_source_trust": {
      "type": "object",
      "additionalProperties": {"type": "string", "enum": ["untrusted", "low", "medium", "high"]},
      "description": "Per-source memory trust levels used by minimum-trust queries.",
      "x-description-ko": "최소 신뢰 쿼리에 사용하는 출처별 메모리 신뢰 수준입니다."
    },
    "shell_approval": {
      "type": "string",
      "enum": ["manual", "smart", "off"]
    },
    "repl_typed_line": {
      "type": "string",
      "enum": ["steer", "kill"]
    },
    "voice": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sample_rate": {"type": "integer", "minimum": 8000},
        "background_workers": {"type": "integer", "minimum": 1}
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "telegram": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {"type": "boolean"},
            "token": {"type": "string", "x-secret": true},
            "allowed_chat_ids": {
              "type": "array",
              "items": {"type": ["string", "integer"]}
            },
            "allowed_sender_ids": {
              "type": "array",
              "items": {"type": ["string", "integer"]}
            },
            "stream": {"type": "boolean"}
          }
        }
      }
    }
  }
}
