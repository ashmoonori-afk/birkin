<UserControl x:Class="Birkin.Native.App.Views.ConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.AutomationId="conversation.landmark"
             automation:AutomationProperties.Name="대화 작업 공간">
    <UserControl.Resources><ResourceDictionary Source="../Styles/ShellStyles.xaml" /></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding OfficeWorkflow.CommandStateText}"
                       Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       automation:AutomationProperties.AutomationId="conversation.command-state" />
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        automation:AutomationProperties.AutomationId="conversation.command-progress"
                        automation:AutomationProperties.Name="{Binding OfficeWorkflow.CommandProgressText}"
                        automation:AutomationProperties.LiveSetting="Polite">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OfficeWorkflow.HasPendingCommand}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Path Width="16"
                      Height="16"
                      Margin="0,0,7,0"
                      Data="M 8,1 A 7,7 0 0 1 15,8"
                      Stretch="None"
                      Stroke="{StaticResource AccentBrush}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      RenderTransformOrigin="0.5,0.5"
                      automation:AutomationProperties.AutomationId="conversation.command-progress-spinner"
                      automation:AutomationProperties.Name="처리 중">
                    <Path.RenderTransform>
                        <RotateTransform />
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0"
                                                     To="360"
                                                     Duration="0:0:0.8" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
                <TextBlock Text="{Binding OfficeWorkflow.CommandProgressText}"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="conversation.command-progress-label" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedBrush}" FontSize="19" Margin="0,0,9,0" />
                <TextBlock Text="대화" Style="{StaticResource SectionTitleStyle}" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl automation:AutomationProperties.AutomationId="conversation.items" ItemsSource="{Binding Workspace.Conversation}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="11" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border>
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource EmptyStateStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding Workspace.Conversation.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="&#xE8BD;" Style="{StaticResource GlyphStyle}" />
                    <TextBlock Text="아직 대화가 없습니다" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Text="Birkin에게 필요한 작업을 요청해 보세요." Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,10,0,0" automation:AutomationProperties.AutomationId="composer.landmark" automation:AutomationProperties.Name="대화 입력">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ItemsControl ItemsSource="{Binding OfficeWorkflow.Imports}"
                              Margin="0,0,0,8"
                              automation:AutomationProperties.AutomationId="conversation.attachments"
                              automation:AutomationProperties.Name="이번 메시지에 첨부할 파일">
                    <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding OfficeWorkflow.Imports.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <CheckBox Content="{Binding DisplayName}"
                                  Tag="{Binding ImportId}"
                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  Margin="0,0,10,4"
                                  Click="AttachmentToggled"
                                  automation:AutomationProperties.AutomationId="{Binding ImportId}"
                                  automation:AutomationProperties.Name="{Binding AccessibleName}"
                                  automation:AutomationProperties.HelpText="선택하면 이번 메시지에 첨부합니다. 선택을 해제해도 가져온 원본은 삭제되지 않습니다." />
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Grid.Row="1">
                    <TextBox x:Name="DraftBox" automation:AutomationProperties.AutomationId="conversation.draft" automation:AutomationProperties.Name="메시지 초안" AcceptsReturn="True" MinHeight="56" MaxHeight="120" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}" IsEnabled="{Binding OfficeWorkflow.Availability.ConversationSend.IsEnabled}" TextChanged="DraftChanged" PreviewKeyDown="DraftPreviewKeyDown" LostKeyboardFocus="DraftKeyboardFocusLost" />
                    <TextBlock Text="Birkin에게 무엇이든 물어보세요..." Foreground="{StaticResource MutedBrush}" Margin="2,1" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=DraftBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                automation:AutomationProperties.AutomationId="conversation.actions"
                                automation:AutomationProperties.Name="대화 동작">
                        <Button x:Name="StopButton" Content="중지" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="conversation.stop" automation:AutomationProperties.Name="응답 중지" automation:AutomationProperties.HelpText="현재 응답을 중지합니다." Style="{StaticResource ComposerActionStyle}" IsEnabled="{Binding OfficeWorkflow.Availability.ConversationInterrupt.IsEnabled}" Click="StopClicked" />
                        <Button x:Name="SendButton" Content="보내기" automation:AutomationProperties.AutomationId="conversation.send" automation:AutomationProperties.Name="메시지 보내기" automation:AutomationProperties.HelpText="Ctrl+Enter로 전송합니다." automation:AutomationProperties.AcceleratorKey="Ctrl+Enter" ToolTip="Ctrl+Enter" Style="{StaticResource ComposerActionStyle}" IsEnabled="{Binding OfficeWorkflow.Availability.ConversationSend.IsEnabled}" Click="SendClicked" />
                    </StackPanel>
                    <TextBlock Text="{Binding OfficeWorkflow.Availability.ConversationSend.DisabledReasonText}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" automation:AutomationProperties.AutomationId="composer.read-only-caption" />
                </DockPanel>
                <StackPanel Grid.Row="3" Margin="0,6,0,0">
                    <Button Content="다시 시도"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,6"
                            automation:AutomationProperties.AutomationId="conversation.retry"
                            automation:AutomationProperties.Name="대화 요청 다시 시도"
                            IsEnabled="{Binding OfficeWorkflow.CanRetryConversation}"
                            Click="RetryClicked">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ComposerActionStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding OfficeWorkflow.CanRetryConversation}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <TextBlock Text="{Binding OfficeWorkflow.RefusalText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="conversation.refusal">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding OfficeWorkflow.RefusalCode}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Expander Header="기술 세부 정보" Margin="0,4,0,0">
                        <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding OfficeWorkflow.RefusalCode}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style>
                        <TextBlock Text="{Binding OfficeWorkflow.RefusalDiagnosticDetail}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    </Expander>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
