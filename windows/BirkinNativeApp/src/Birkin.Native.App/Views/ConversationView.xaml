<UserControl x:Class="Birkin.Native.App.Views.ConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.AutomationId="conversation.landmark"
             automation:AutomationProperties.Name="Conversation workspace">
    <UserControl.Resources><ResourceDictionary Source="../Styles/ShellStyles.xaml" /></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        automation:AutomationProperties.AutomationId="conversation.command-progress"
                        automation:AutomationProperties.Name="{Binding OfficeWorkflow.CommandProgressText}"
                        automation:AutomationProperties.LiveSetting="Polite">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OfficeWorkflow.HasPendingCommand}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Path Width="16"
                      Height="16"
                      Margin="0,0,7,0"
                      Data="M 8,1 A 7,7 0 0 1 15,8"
                      Stretch="None"
                      Stroke="{StaticResource AccentBrush}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      RenderTransformOrigin="0.5,0.5"
                      automation:AutomationProperties.AutomationId="conversation.command-progress-spinner"
                      automation:AutomationProperties.Name="처리 중">
                    <Path.RenderTransform>
                        <RotateTransform />
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0"
                                                     To="360"
                                                     Duration="0:0:0.8" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
                <TextBlock Text="{Binding OfficeWorkflow.CommandProgressText}"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="conversation.command-progress-label" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedBrush}" FontSize="19" Margin="0,0,9,0" />
                <TextBlock Text="Conversation" Style="{StaticResource SectionTitleStyle}" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl automation:AutomationProperties.AutomationId="conversation.items" ItemsSource="{Binding Workspace.Conversation}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="11" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Kind}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border>
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource EmptyStateStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding Workspace.Conversation.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="&#xE8BD;" Style="{StaticResource GlyphStyle}" />
                    <TextBlock Text="No messages yet" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Text="Ask Birkin to help with a task." Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,10,0,0" automation:AutomationProperties.AutomationId="composer.landmark" automation:AutomationProperties.Name="Conversation composer">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <TextBox x:Name="DraftBox" automation:AutomationProperties.AutomationId="conversation.draft" automation:AutomationProperties.Name="Message draft" AcceptsReturn="True" MinHeight="56" MaxHeight="120" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}" IsEnabled="{Binding OfficeWorkflow.Availability.ConversationSend.IsEnabled}" TextChanged="DraftChanged" PreviewKeyDown="DraftPreviewKeyDown" LostKeyboardFocus="DraftKeyboardFocusLost" />
                    <TextBlock Text="Ask Birkin anything..." Foreground="{StaticResource MutedBrush}" Margin="2,1" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=DraftBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                automation:AutomationProperties.AutomationId="conversation.actions"
                                automation:AutomationProperties.Name="Conversation actions">
                        <Button x:Name="StopButton" Content="Stop" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="conversation.stop" automation:AutomationProperties.Name="Stop response" automation:AutomationProperties.HelpText="Stops the current response." Style="{StaticResource ComposerActionStyle}" IsEnabled="{Binding OfficeWorkflow.Availability.ConversationInterrupt.IsEnabled}" Click="StopClicked" />
                        <Button x:Name="SendButton" Content="Send" automation:AutomationProperties.AutomationId="conversation.send" automation:AutomationProperties.Name="Send message" automation:AutomationProperties.HelpText="Press Ctrl+Enter to send." automation:AutomationProperties.AcceleratorKey="Ctrl+Enter" ToolTip="Ctrl+Enter" Style="{StaticResource ComposerActionStyle}" IsEnabled="{Binding OfficeWorkflow.Availability.ConversationSend.IsEnabled}" Click="SendClicked" />
                    </StackPanel>
                    <TextBlock Text="{Binding OfficeWorkflow.Availability.ConversationSend.DisabledReason}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" automation:AutomationProperties.AutomationId="composer.read-only-caption" />
                </DockPanel>
                <TextBlock Grid.Row="2" Margin="0,6,0,0" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding OfficeWorkflow.RefusalCode}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    <Run Text="{Binding OfficeWorkflow.RefusalCode}"/><Run Text="  Cursor "/><Run Text="{Binding OfficeWorkflow.CurrentCursor}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
