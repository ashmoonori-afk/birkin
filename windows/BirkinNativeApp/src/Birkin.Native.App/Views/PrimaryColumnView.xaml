<UserControl x:Class="Birkin.Native.App.Views.PrimaryColumnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <UserControl.Resources>
        <ResourceDictionary Source="../Styles/ShellStyles.xaml" />
    </UserControl.Resources>
    <Grid x:Name="PrimaryColumn"
          automation:AutomationProperties.AutomationId="primary.column"
          automation:AutomationProperties.Name="대화 작업 영역">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="4,0,4,12">
            <TextBlock x:Name="WorkspaceTitle" Text="대화" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       automation:AutomationProperties.AutomationId="workspace.route.title" />
            <TextBlock x:Name="WorkspaceDescription" Text="현재 업무의 대화와 요청을 이어갑니다."
                       Style="{StaticResource MutedTextStyle}" />
        </StackPanel>

        <Border x:Name="ConversationRegion"
                Grid.Row="1"
                automation:AutomationProperties.AutomationId="conversation.stream"
                automation:AutomationProperties.Name="대화와 메시지 입력"
                Style="{StaticResource CardStyle}">
            <Grid>
                <ContentControl x:Name="ConversationHost" />
                <ContentControl x:Name="ResearchHost" Visibility="Collapsed" />
            </Grid>
        </Border>

        <Expander x:Name="TerminalRegion"
                  Grid.Row="2"
                  Header="터미널"
                  IsExpanded="False" Visibility="Collapsed"
                  Margin="0,5,0,0"
                  Foreground="{StaticResource TextBrush}"
                  automation:AutomationProperties.AutomationId="terminal.landmark"
                  automation:AutomationProperties.Name="Windows 터미널 상태">
            <Border Background="{StaticResource TerminalBrush}"
                    CornerRadius="7"
                    MinHeight="160"
                    Margin="0,8,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#xE756;" Style="{StaticResource GlyphStyle}" />
                        <TextBlock Text="Windows에서는 터미널을 아직 사용할 수 없습니다"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                        <TextBlock Text="이 플랫폼에서 터미널 연결 기능을 준비하고 있습니다."
                                   Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
            </Border>
        </Expander>
    </Grid>
</UserControl>
