<UserControl x:Class="Birkin.Native.App.Views.PrimaryColumnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <UserControl.Resources>
        <ResourceDictionary Source="../Styles/ShellStyles.xaml" />
    </UserControl.Resources>
    <Grid x:Name="PrimaryColumn"
          automation:AutomationProperties.AutomationId="primary.column">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Border x:Name="ConversationRegion"
                automation:AutomationProperties.AutomationId="conversation.stream"
                Style="{StaticResource CardStyle}">
            <ContentControl x:Name="ConversationHost" />
        </Border>

        <Border x:Name="TerminalRegion"
                Grid.Row="2"
                automation:AutomationProperties.AutomationId="terminal.landmark"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&gt;_" FontFamily="Consolas" FontSize="17"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="터미널" Style="{StaticResource SectionTitleStyle}" />
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource TerminalBrush}" CornerRadius="7" Margin="0,10,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#xE756;" Style="{StaticResource GlyphStyle}" />
                        <TextBlock Text="Windows에서는 터미널을 아직 사용할 수 없습니다"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                        <TextBlock Text="이 플랫폼에서 터미널 연결 기능을 준비하고 있습니다."
                                   Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
