<UserControl x:Class="Birkin.Native.App.Views.NavigationColumnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <UserControl.Resources>
        <ResourceDictionary Source="../Styles/ShellStyles.xaml" />
    </UserControl.Resources>
    <Grid x:Name="NavigationColumn"
          automation:AutomationProperties.AutomationId="navigation.column">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <Border x:Name="SessionsRegion"
                automation:AutomationProperties.AutomationId="navigation.sessions"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource DisabledActionStyle}"
                            Content="+"
                            Width="34"
                            automation:AutomationProperties.AutomationId="sessions.new"
                            automation:AutomationProperties.Name="새 업무 만들기는 아직 사용할 수 없음" />
                    <TextBlock Text="업무" Style="{StaticResource SectionTitleStyle}" />
                </DockPanel>
                <Border Grid.Row="1"
                        Background="{StaticResource RaisedBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8BD;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="17"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="현재 업무" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding Workspace.SessionId}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontFamily="Consolas"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Ellipse Grid.Column="2"
                                 Width="14" Height="14"
                                 Stroke="{StaticResource AccentBrush}"
                                 StrokeThickness="2"
                                 Fill="{StaticResource CardBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="WorkingMemoryRegion"
                Grid.Row="2"
                automation:AutomationProperties.AutomationId="working-memory.landmark"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource DisabledActionStyle}"
                            Content="비우기"
                            automation:AutomationProperties.Name="작업 기억 비우기"
                            automation:AutomationProperties.AutomationId="working-memory.clear" />
                    <StackPanel>
                        <TextBlock Text="작업 기억" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding Workspace.WorkingMemory.Revision, StringFormat=버전 {0}}"
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="WorkingMemoryItems"
                                  automation:AutomationProperties.AutomationId="working-memory.items"
                                  ItemsSource="{Binding Workspace.WorkingMemory.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource RaisedBrush}"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center" />
                                        <ItemsControl Grid.Column="1"
                                                      ItemsSource="{Binding Values}"
                                                      HorizontalAlignment="Right">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Values.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               TextAlignment="Right"
                                                               TextWrapping="Wrap"
                                                               MaxWidth="140"
                                                               Margin="0,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Grid.Column="1"
                                                BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="8,3"
                                                HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Values.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EmptyState}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="11" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,8,0,0">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="이 기기에만 저장됨"
                               Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
