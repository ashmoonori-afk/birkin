<UserControl x:Class="Birkin.Native.App.Views.NavigationColumnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <UserControl.Resources>
        <ResourceDictionary Source="../Styles/ShellStyles.xaml" />
    </UserControl.Resources>
    <Grid x:Name="NavigationColumn"
          automation:AutomationProperties.AutomationId="navigation.column"
          automation:AutomationProperties.Name="업무 목록과 작업 기억">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Border x:Name="SessionsRegion"
                automation:AutomationProperties.AutomationId="navigation.sessions"
                automation:AutomationProperties.Name="업무 목록"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right"
                            Click="CreateSessionClicked"
                            IsEnabled="{Binding OfficeWorkflow.Availability.SessionCreate.IsEnabled}"
                            Content="+"
                            Width="34"
                            automation:AutomationProperties.AutomationId="sessions.new"
                            automation:AutomationProperties.Name="새 업무 만들기" />
                    <TextBlock Text="업무" Style="{StaticResource SectionTitleStyle}" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Workspace.Sessions}"
                                  automation:AutomationProperties.AutomationId="sessions.items">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding SessionId}"
                                        Click="SelectSessionClicked"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,6"
                                        Padding="10,8"
                                        automation:AutomationProperties.Name="{Binding SessionDisplayName}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedSession}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SessionDisplayName}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SessionId}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <DockPanel Grid.Row="2" Margin="0,6,0,6">
                    <Button DockPanel.Dock="Right"
                            Content="이름 변경"
                            Click="RenameSessionClicked"
                            IsEnabled="{Binding OfficeWorkflow.Availability.SessionRename.IsEnabled}"
                            Padding="8,4"
                            automation:AutomationProperties.AutomationId="sessions.rename" />
                    <TextBox x:Name="SessionNameInput"
                             Margin="0,0,6,0"
                             Padding="7,4"
                             automation:AutomationProperties.Name="현재 업무의 새 이름" />
                </DockPanel>
                <Button Grid.Row="3"
                        HorizontalContentAlignment="Left"
                        Click="ShowHistoryClicked"
                        IsEnabled="{Binding OfficeWorkflow.Availability.SessionSelect.IsEnabled}"
                        Padding="8,5"
                        Content="{Binding Workspace.RecentResults.Count, StringFormat=최근 결과 {0}개 · 활동 기록 보기}"
                        automation:AutomationProperties.AutomationId="sessions.history" />
            </Grid>
        </Border>

        <Border x:Name="WorkingMemoryRegion"
                Grid.Row="2"
                automation:AutomationProperties.AutomationId="working-memory.landmark"
                automation:AutomationProperties.Name="현재 업무의 작업 기억"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource DisabledActionStyle}"
                            Content="비우기"
                            automation:AutomationProperties.Name="작업 기억 비우기"
                            automation:AutomationProperties.AutomationId="working-memory.clear" />
                    <StackPanel>
                        <TextBlock Text="작업 기억" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding Workspace.WorkingMemory.Revision, StringFormat=버전 {0}}"
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="WorkingMemoryItems"
                                  automation:AutomationProperties.AutomationId="working-memory.items"
                                  ItemsSource="{Binding Workspace.WorkingMemory.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource RaisedBrush}"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center" />
                                        <ItemsControl Grid.Column="1"
                                                      ItemsSource="{Binding Values}"
                                                      HorizontalAlignment="Right">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Values.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               TextAlignment="Right"
                                                               TextWrapping="Wrap"
                                                               MaxWidth="140"
                                                               Margin="0,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Grid.Column="1"
                                                BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="8,3"
                                                HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Values.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EmptyState}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="11" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,8,0,0">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="이 기기에만 저장됨"
                               Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
