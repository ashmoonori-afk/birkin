<UserControl x:Class="Birkin.Native.App.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.AutomationId="import.landmark"
             automation:AutomationProperties.Name="업무 문서 가져오기">
    <UserControl.Resources><ResourceDictionary Source="../Styles/ShellStyles.xaml" /></UserControl.Resources>
    <StackPanel Margin="0,8,0,0">
        <TextBox x:Name="PathBox"
                 automation:AutomationProperties.AutomationId="import.path"
                 automation:AutomationProperties.Name="가져올 문서 경로"
                 Background="{StaticResource RaisedBrush}"
                 BorderBrush="{StaticResource BorderBrush}"
                 Foreground="{StaticResource TextBrush}"
                 IsReadOnly="True"
                 Padding="8,6"
                 ToolTip="선택한 파일을 현재 세션의 안전한 작업공간으로 복사합니다." />
        <TextBlock Margin="0,6,0,0"
                   Text="DOCX·XLSX·PPTX·HWPX는 읽기·수정할 수 있습니다. PDF는 읽기·검증 중심이며 일부 기능은 office-advanced 설치가 필요합니다. TXT는 참고 자료로 가져올 수 있습니다. 기존 HWP는 지원하지 않습니다."
                   Style="{StaticResource MutedTextStyle}"
                   TextWrapping="Wrap"
                   automation:AutomationProperties.AutomationId="import.support-policy" />
        <WrapPanel Margin="0,8,0,0"
                   HorizontalAlignment="Right"
                   automation:AutomationProperties.AutomationId="import.actions"
                   automation:AutomationProperties.Name="문서 가져오기 동작">
            <Button x:Name="BrowseButton"
                    Content="찾아보기"
                    Margin="0,0,8,8"
                    automation:AutomationProperties.AutomationId="import.browse"
                    automation:AutomationProperties.Name="가져올 업무 문서 선택"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="BrowseClicked" />
            <Button x:Name="ImportButton"
                    Content="가져오기"
                    Margin="0,0,0,8"
                    automation:AutomationProperties.AutomationId="import.submit"
                    automation:AutomationProperties.Name="선택한 업무 문서 가져오기"
                    Style="{StaticResource ActionButtonStyle}"
                    IsEnabled="{Binding OfficeWorkflow.Availability.FileImport.IsEnabled}"
                    Click="ImportClicked" />
        </WrapPanel>
        <TextBlock x:Name="StatusText"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   automation:AutomationProperties.AutomationId="import.status"
                   automation:AutomationProperties.LiveSetting="Assertive" />
        <ItemsControl Margin="0,8,0,0"
                      ItemsSource="{Binding OfficeWorkflow.Imports}"
                      automation:AutomationProperties.AutomationId="import.chips"
                      automation:AutomationProperties.Name="가져온 문서">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,8,8"
                            Padding="8,6"
                            MaxWidth="240"
                            Background="{StaticResource RaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            automation:AutomationProperties.AutomationId="import.chip"
                            automation:AutomationProperties.Name="{Binding AccessibleName}">
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       ToolTip="{Binding DisplayName}" />
                            <TextBlock Text="{Binding ByteCount, StringFormat={}{0:N0} bytes}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
