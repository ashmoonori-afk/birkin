<UserControl x:Class="Birkin.Native.App.Views.WorkspaceSnapshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Focusable="True">
    <UserControl.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E99A8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F7FA" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#17231F" BorderBrush="#2B7D62" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="CONNECTION" Style="{StaticResource LabelText}" />
                    <TextBlock x:Name="ConnectionStatusText"
                               automation:AutomationProperties.AutomationId="ConnectionStatusText"
                               Text="{Binding Connection.StatusText}"
                               Foreground="#79D6B1"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="TRANSPORT" Style="{StaticResource LabelText}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="TransportText"
                               automation:AutomationProperties.AutomationId="TransportText"
                               Text="{Binding Workspace.Transport}"
                               Style="{StaticResource ValueText}"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ItemsControl Grid.Row="1">
            <ItemsControl.Items>
                <Border Background="#151A21" CornerRadius="8" Padding="18" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="SESSION" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="SessionIdText" automation:AutomationProperties.AutomationId="SessionIdText"
                                   Text="{Binding Workspace.SessionId}" Style="{StaticResource ValueText}" />
                    </StackPanel>
                </Border>
                <Border Background="#151A21" CornerRadius="8" Padding="18" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="CURSOR" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="CursorText" automation:AutomationProperties.AutomationId="CursorText"
                                   Text="{Binding Workspace.Cursor}" Style="{StaticResource ValueText}" />
                    </StackPanel>
                </Border>
                <Border Background="#151A21" CornerRadius="8" Padding="18" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="RESET REASON" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="ResetReasonText" automation:AutomationProperties.AutomationId="ResetReasonText"
                                   Text="{Binding Workspace.ResetReason}" Style="{StaticResource ValueText}" />
                    </StackPanel>
                </Border>
                <Border Background="#151A21" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="PANEL COUNT" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="PanelCountText" automation:AutomationProperties.AutomationId="PanelCountText"
                                   Text="{Binding Workspace.PanelCount}" Style="{StaticResource ValueText}" />
                    </StackPanel>
                </Border>
            </ItemsControl.Items>
        </ItemsControl>
    </Grid>
</UserControl>
