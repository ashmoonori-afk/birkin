<UserControl x:Class="Birkin.Native.App.Views.WorkspaceSnapshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:views="clr-namespace:Birkin.Native.App.Views"
             Background="{DynamicResource CanvasBrush}"
             Focusable="True">
    <UserControl.Resources>
        <ResourceDictionary Source="../Styles/ShellStyles.xaml" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Grid>
            <Menu HorizontalAlignment="Left" VerticalAlignment="Top"
                  Background="Transparent" Foreground="{StaticResource TextBrush}">
                <MenuItem Header="보기(_V)">
                    <MenuItem x:Name="NavigationMenuItem" Header="내비게이션 패널(_N)"
                              ToolTip="Toggle Navigation panel" InputGestureText="Ctrl+B"
                              IsCheckable="True" IsChecked="True" Click="ToggleNavigationClicked"
                              automation:AutomationProperties.AutomationId="menu.view.navigation" />
                    <MenuItem x:Name="ContextMenuItem" Header="컨텍스트 패널(_C)"
                              ToolTip="Toggle Context panel" InputGestureText="Ctrl+Shift+B"
                              IsCheckable="True" IsChecked="True" Click="ToggleContextClicked"
                              automation:AutomationProperties.AutomationId="menu.view.context" />
                    <MenuItem x:Name="FocusMenuItem" Header="대화에 집중(_F)"
                              ToolTip="Focus conversation" InputGestureText="Ctrl+Shift+F"
                              IsCheckable="True" Click="ToggleFocusClicked"
                              automation:AutomationProperties.AutomationId="menu.view.focus" />
                    <Separator />
                    <MenuItem Header="레이아웃 초기화(_R)" ToolTip="Reset layout"
                              InputGestureText="Ctrl+Shift+0" Click="ResetLayoutClicked"
                              automation:AutomationProperties.AutomationId="menu.view.reset" />
                </MenuItem>
            </Menu>
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,7">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,9,0"
                             automation:AutomationProperties.AutomationId="ConnectionStatusIndicator">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource FaintBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Connection.State}" Value="Connecting"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Connection.State}" Value="Handshaking"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Connection.State}" Value="Subscribing"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Connection.State}" Value="Ready"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Connection.State}" Value="Failed"><Setter Property="Fill" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="ConnectionStatusText"
                               automation:AutomationProperties.AutomationId="ConnectionStatusText"
                               Text="{Binding Connection.StatusText}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="IsEnabled" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasStartupFailure}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="280" MinWidth="240" MaxWidth="480" />
                <ColumnDefinition x:Name="NavigationSplitterColumn" Width="6" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition x:Name="ContextSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="ContextColumn" Width="340" MinWidth="300" MaxWidth="600" />
            </Grid.ColumnDefinitions>
            <views:NavigationColumnView x:Name="NavigationColumnView" Grid.Column="0" />
            <GridSplitter x:Name="NavigationSplitter" Grid.Column="1"
                          Style="{StaticResource PanelSplitterStyle}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          HorizontalAlignment="Stretch" Width="6" Margin="-2,0"
                          DragIncrement="1" KeyboardIncrement="8" ShowsPreview="False"
                          PreviewMouseLeftButtonDown="SplitterPreviewMouseLeftButtonDown"
                          DragStarted="SplitterDragStarted"
                          DragCompleted="NavigationSplitterDragCompleted"
                          MouseDoubleClick="NavigationSplitterDoubleClicked"
                          automation:AutomationProperties.AutomationId="workspace.splitter.navigation"
                          automation:AutomationProperties.Name="내비게이션 패널 크기 조절" />
            <views:PrimaryColumnView x:Name="PrimaryColumnView" Grid.Column="2" />
            <GridSplitter x:Name="ContextSplitter" Grid.Column="3"
                          Style="{StaticResource PanelSplitterStyle}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          HorizontalAlignment="Stretch" Width="6" Margin="-2,0"
                          DragIncrement="1" KeyboardIncrement="8" ShowsPreview="False"
                          PreviewMouseLeftButtonDown="SplitterPreviewMouseLeftButtonDown"
                          DragStarted="SplitterDragStarted"
                          DragCompleted="ContextSplitterDragCompleted"
                          MouseDoubleClick="ContextSplitterDoubleClicked"
                          automation:AutomationProperties.AutomationId="workspace.splitter.context"
                          automation:AutomationProperties.Name="컨텍스트 패널 크기 조절" />
            <views:ContextColumnView x:Name="ContextColumnView" Grid.Column="4" />
            <Button x:Name="NavigationHotStrip" Grid.Column="2" Width="4" Padding="0"
                    HorizontalAlignment="Left" Cursor="Hand" Visibility="Collapsed" IsEnabled="False"
                    ToolTipService.InitialShowDelay="400" ToolTip="내비게이션 패널 표시 (Ctrl+B)"
                    Background="Transparent" BorderThickness="0" Click="ShowNavigationClicked" />
            <Button x:Name="ContextHotStrip" Grid.Column="2" Width="4" Padding="0"
                    HorizontalAlignment="Right" Cursor="Hand" Visibility="Collapsed" IsEnabled="False"
                    ToolTipService.InitialShowDelay="400" ToolTip="컨텍스트 패널 표시 (Ctrl+Shift+B)"
                    Background="Transparent" BorderThickness="0" Click="ShowContextClicked" />
        </Grid>

        <Grid Grid.Row="1"
              Panel.ZIndex="10"
              Background="{StaticResource CanvasBrush}"
              KeyboardNavigation.TabNavigation="Cycle">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasStartupFailure}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border automation:AutomationProperties.AutomationId="startup.failure"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="620"
                    Margin="24"
                    Background="{StaticResource RaisedBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel>
                    <TextBlock x:Name="StartupFailureTitle"
                               Text="{Binding StartupFailure.Title}"
                               automation:AutomationProperties.AutomationId="startup.failure.title"
                               automation:AutomationProperties.Name="{Binding StartupFailure.Title}"
                               automation:AutomationProperties.LiveSetting="Assertive"
                               Focusable="True"
                               IsVisibleChanged="StartupFailureTitleVisibilityChanged"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap">
                        <TextBlock.FocusVisualStyle>
                            <Style>
                                <Setter Property="Control.Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Rectangle Stroke="{StaticResource AccentBrush}"
                                                       StrokeThickness="2"
                                                       RadiusX="3"
                                                       RadiusY="3"
                                                       Margin="-4" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBlock.FocusVisualStyle>
                    </TextBlock>
                    <TextBlock Text="{Binding StartupFailure.Explanation}"
                               automation:AutomationProperties.AutomationId="startup.failure.explanation"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StartupFailure.RecoveryAction}"
                               automation:AutomationProperties.AutomationId="startup.failure.recovery"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StartupFailure.ErrorCode}"
                               automation:AutomationProperties.AutomationId="startup.failure.code"
                               Foreground="{StaticResource MutedBrush}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Margin="0,12,0,0" />
                    <TextBlock Text="Birkin 실행 파일 경로"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,16,0,5" />
                    <TextBox x:Name="ExecutablePathInput"
                             automation:AutomationProperties.AutomationId="startup.failure.executable-path"
                             automation:AutomationProperties.Name="Birkin 실행 파일 경로"
                             Foreground="{StaticResource TextBrush}"
                             Background="{StaticResource TerminalBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="8,6"
                             TextWrapping="NoWrap" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">
                        <Button Content="경로 저장 후 다시 시도"
                                automation:AutomationProperties.AutomationId="startup.failure.configure"
                                automation:AutomationProperties.Name="Birkin 실행 파일 경로를 저장하고 다시 시도"
                                Style="{StaticResource DisabledActionStyle}"
                                IsEnabled="{Binding StartupFailure.CanRetry}"
                                Click="ConfigureExecutableClicked" />
                        <Button Content="다시 시도"
                                automation:AutomationProperties.AutomationId="startup.failure.retry"
                                automation:AutomationProperties.Name="Birkin CLI 시작 다시 시도"
                                Style="{StaticResource DisabledActionStyle}"
                                IsEnabled="{Binding StartupFailure.CanRetry}"
                                Margin="8,0,0,0"
                                Click="RetryStartupClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                automation:AutomationProperties.AutomationId="workspace.status"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="6,6,0,0"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LayoutTipText" Grid.Column="0" Visibility="Collapsed"
                           HorizontalAlignment="Left" Margin="0,0,12,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                           Text="패널을 드래그해 크기를 조절하고 Ctrl+B / Ctrl+Shift+B로 숨길 수 있습니다." />
                <StackPanel x:Name="DiagnosticStatusGroup" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Transport " Foreground="{StaticResource FaintBrush}" />
                    <TextBlock x:Name="TransportText"
                               automation:AutomationProperties.AutomationId="TransportText"
                               Text="{Binding Workspace.Transport}" />
                    <TextBlock Text="  ·  Session " Foreground="{StaticResource FaintBrush}" />
                    <TextBlock x:Name="SessionIdText"
                               automation:AutomationProperties.AutomationId="SessionIdText"
                               Text="{Binding Workspace.SessionId}" />
                    <TextBlock Text="  ·  Cursor " Foreground="{StaticResource FaintBrush}" />
                    <TextBlock x:Name="CursorText"
                               automation:AutomationProperties.AutomationId="CursorText"
                               Text="{Binding Workspace.Cursor}" />
                    <TextBlock Text="  ·  Reset " Foreground="{StaticResource FaintBrush}" />
                    <TextBlock x:Name="ResetReasonText"
                               automation:AutomationProperties.AutomationId="ResetReasonText"
                               Text="{Binding Workspace.ResetReason}" />
                    <TextBlock Text="  ·  Panels " Foreground="{StaticResource FaintBrush}" />
                    <TextBlock x:Name="PanelCountText"
                               automation:AutomationProperties.AutomationId="PanelCountText"
                               Text="{Binding Workspace.PanelCount}" />
                </StackPanel>
                <StackPanel x:Name="RestoreActionGroup" Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="12,0,0,0">
                    <Button x:Name="RestoreNavigationButton" Content="▸ 내비게이션"
                            Style="{StaticResource RestoreChipStyle}" Visibility="Collapsed" IsEnabled="False"
                            Click="ShowNavigationClicked"
                            automation:AutomationProperties.AutomationId="workspace.status.restore.navigation"
                            automation:AutomationProperties.Name="내비게이션 패널 표시" />
                    <Button x:Name="RestoreContextButton" Content="◂ 컨텍스트"
                            Style="{StaticResource RestoreChipStyle}" Visibility="Collapsed" IsEnabled="False"
                            Click="ShowContextClicked" Margin="6,0,0,0"
                            automation:AutomationProperties.AutomationId="workspace.status.restore.context"
                            automation:AutomationProperties.Name="컨텍스트 패널 표시" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
