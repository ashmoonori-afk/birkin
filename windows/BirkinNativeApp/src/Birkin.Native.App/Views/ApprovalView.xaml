<UserControl x:Class="Birkin.Native.App.Views.ApprovalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.AutomationId="approval.workflow"
             automation:AutomationProperties.Name="Projected approvals">
    <UserControl.Resources><ResourceDictionary Source="../Styles/ShellStyles.xaml" /></UserControl.Resources>
    <Grid MinHeight="54">
        <ItemsControl x:Name="ApprovalItems" automation:AutomationProperties.AutomationId="approval.items" ItemsSource="{Binding ApprovalRows, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{StaticResource RaisedBrush}" CornerRadius="6" Padding="9,7" Margin="0,0,0,6">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                            <Button Content="Reject" Tag="{Binding Id}" Margin="0,0,5,0" automation:AutomationProperties.AutomationId="approval.reject" automation:AutomationProperties.Name="Reject requested operation" Style="{StaticResource DisabledActionStyle}" IsEnabled="{Binding DataContext.OfficeWorkflow.Availability.ApprovalAnswer.IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Click="RejectClicked" />
                            <Button Content="Approve" Tag="{Binding Id}" automation:AutomationProperties.AutomationId="approval.approve" automation:AutomationProperties.Name="Approve requested operation" Style="{StaticResource DisabledActionStyle}" IsEnabled="{Binding DataContext.OfficeWorkflow.Availability.ApprovalAnswer.IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Click="ApproveClicked" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel VerticalAlignment="Center">
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ApprovalRows.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="&#xEA18;" Style="{StaticResource GlyphStyle}" FontSize="22" />
            <TextBlock Text="No approvals pending" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
