<UserControl x:Class="Birkin.Native.App.Views.ApprovalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.AutomationId="approval.workflow"
             automation:AutomationProperties.Name="{DynamicResource ApprovalSurfaceName}">
    <UserControl.Resources><ResourceDictionary Source="../Styles/ShellStyles.xaml" /></UserControl.Resources>
    <Grid MinHeight="54">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ItemsControl Grid.Row="0" x:Name="ApprovalItems" automation:AutomationProperties.AutomationId="approval.items" ItemsSource="{Binding ApprovalRows, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{StaticResource RaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,8"
                        automation:AutomationProperties.AutomationId="{Binding CardAutomationId}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel>
                            <Border BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="7,2"
                                    Margin="0,0,7,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource FaintBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Risk}" Value="low">
                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Risk}" Value="medium">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Risk}" Value="high">
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Risk}" Value="critical">
                                                <Setter Property="BorderBrush" Value="{StaticResource CriticalBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           automation:AutomationProperties.AutomationId="{Binding RiskAutomationId}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{StaticResource ApprovalRiskUnknown}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Risk}" Value="low"><Setter Property="Text" Value="{StaticResource ApprovalRiskLow}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Risk}" Value="medium"><Setter Property="Text" Value="{StaticResource ApprovalRiskMedium}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Risk}" Value="high"><Setter Property="Text" Value="{StaticResource ApprovalRiskHigh}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Risk}" Value="critical"><Setter Property="Text" Value="{StaticResource ApprovalRiskCritical}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding CategoryLabel}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       automation:AutomationProperties.AutomationId="{Binding SealedAutomationId}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Text" Value="{StaticResource ApprovalSealed}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sealed}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                <Setter Property="Text" Value="{StaticResource ApprovalNotSealed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </WrapPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Summary}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding Description}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"
                                   automation:AutomationProperties.AutomationId="{Binding DescriptionAutomationId}"/>
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <TextBlock Text="{Binding RequesterLabel}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       automation:AutomationProperties.AutomationId="{Binding RequesterAutomationId}"/>
                            <TextBlock Text="{Binding ExpiryLabel}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding RejectionResultLabel}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       automation:AutomationProperties.AutomationId="{Binding RejectionAutomationId}"/>
                        </StackPanel>
                        <Border Grid.Row="4"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9,7"
                                Margin="0,9,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTrustDetails}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Margin="0,0,0,7">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSourceFilename}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{StaticResource ApprovalSourceLabel}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SourceFilename}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               automation:AutomationProperties.AutomationId="{Binding SourceAutomationId}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,7">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDestination}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{StaticResource ApprovalDestinationLabel}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DestinationDisplay}"
                                               ToolTip="{Binding Destination}"
                                               automation:AutomationProperties.HelpText="{Binding Destination}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               automation:AutomationProperties.AutomationId="{Binding DestinationAutomationId}"/>
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,0"
                                               automation:AutomationProperties.AutomationId="{Binding OverwriteAutomationId}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Text" Value="{StaticResource ApprovalOverwriteUnknown}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OverwriteApproved}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        <Setter Property="Text" Value="{StaticResource ApprovalOverwriteWarning}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OverwriteApproved}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        <Setter Property="Text" Value="{StaticResource ApprovalOverwriteSafe}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="{StaticResource ApprovalCopyPathLabel}"
                                            Tag="{Binding Destination}"
                                            Foreground="{StaticResource AccentBrush}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            HorizontalAlignment="Left"
                                            Margin="0,4,0,0"
                                            automation:AutomationProperties.AutomationId="{Binding CopyDestinationAutomationId}"
                                            Click="CopyFullValueClicked"/>
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAuthorityDigest}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{StaticResource ApprovalAuthorityLabel}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding AuthorityDigestDisplay}"
                                               ToolTip="{Binding AuthorityDigest}"
                                               automation:AutomationProperties.HelpText="{Binding AuthorityDigest}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Content="{StaticResource ApprovalCopyAuthorityLabel}"
                                            Tag="{Binding AuthorityDigest}"
                                            Foreground="{StaticResource AccentBrush}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            HorizontalAlignment="Left"
                                            Margin="0,4,0,0"
                                            automation:AutomationProperties.AutomationId="{Binding CopyAuthorityAutomationId}"
                                            Click="CopyFullValueClicked"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="5"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,9,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasReceipt}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="저장 위치"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding Destination}"
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           automation:AutomationProperties.AutomationId="{Binding ReceiptDestinationAutomationId}"/>
                                <TextBlock Text="{Binding RollbackAvailabilityLabel}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           Margin="0,7,0,0"
                                           automation:AutomationProperties.AutomationId="{Binding ReceiptRetentionAutomationId}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="파일 열기"
                                            Margin="0,0,5,0"
                                            automation:AutomationProperties.AutomationId="{Binding OpenFileAutomationId}"
                                            Click="OpenFileClicked"/>
                                    <Button Content="폴더 열기"
                                            Margin="0,0,5,0"
                                            automation:AutomationProperties.AutomationId="{Binding OpenFolderAutomationId}"
                                            Click="OpenFolderClicked"/>
                                    <Button Content="되돌리기"
                                            IsEnabled="{Binding CanRollback}"
                                            automation:AutomationProperties.AutomationId="{Binding RollbackAutomationId}"
                                            Click="RollbackClicked"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="6"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,9,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Decided}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="{StaticResource ApprovalRejectLabel}" Tag="{Binding Id}" Margin="0,0,5,0" automation:AutomationProperties.AutomationId="{Binding RejectAutomationId}" automation:AutomationProperties.Name="{StaticResource ApprovalRejectAutomationName}" Style="{StaticResource DisabledActionStyle}" IsEnabled="{Binding DataContext.OfficeWorkflow.Availability.ApprovalAnswer.IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Click="RejectClicked" />
                            <Button Content="{StaticResource ApprovalApproveLabel}" Tag="{Binding Id}" automation:AutomationProperties.AutomationId="{Binding ApproveAutomationId}" automation:AutomationProperties.Name="{StaticResource ApprovalApproveAutomationName}" Style="{StaticResource DisabledActionStyle}" IsEnabled="{Binding DataContext.OfficeWorkflow.Availability.ApprovalAnswer.IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Click="ApproveClicked" />
                        </StackPanel>
                        <StackPanel Grid.Row="6"
                                    Margin="0,9,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Decided}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding OutcomeLabel}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       automation:AutomationProperties.AutomationId="{Binding OutcomeAutomationId}"/>
                            <TextBlock Text="{Binding ReceiptRef}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"
                                       automation:AutomationProperties.AutomationId="{Binding ReceiptReferenceAutomationId}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasReceipt}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ApprovalRows.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="&#xEA18;" Style="{StaticResource GlyphStyle}" FontSize="22" />
            <TextBlock Text="{StaticResource ApprovalEmptyLabel}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0" />
        </StackPanel>
        <Expander Grid.Row="1"
                  Header="결정됨"
                  IsExpanded="False"
                  Margin="0,8,0,0"
                  Foreground="{StaticResource TextBrush}"
                  automation:AutomationProperties.Name="결정한 승인 요청"
                  automation:AutomationProperties.AutomationId="approval.decided.section">
            <Expander.Style>
                <Style TargetType="Expander">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DecidedApprovalRows.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Expander.Style>
            <ItemsControl ItemsSource="{Binding DecidedApprovalRows, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          ItemTemplate="{Binding ItemTemplate, ElementName=ApprovalItems}"
                          automation:AutomationProperties.AutomationId="approval.decided.items"/>
        </Expander>
        <TextBlock Grid.Row="2"
                   x:Name="DecisionStatus"
                   Text="{StaticResource ApprovalSendingLabel}"
                   Foreground="{StaticResource AccentBrush}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Visibility="Collapsed"
                   Margin="0,5,0,0"
                   automation:AutomationProperties.AutomationId="approval.decision-status"
                   automation:AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</UserControl>
