<UserControl x:Class="Birkin.Native.App.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.AutomationId="diff.landmark"
             automation:AutomationProperties.Name="Projected office differences">
    <UserControl.Resources><ResourceDictionary Source="../Styles/ShellStyles.xaml" /></UserControl.Resources>
    <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
        <StackPanel>
            <DockPanel Margin="0,0,0,5">
                <TextBlock DockPanel.Dock="Right" automation:AutomationProperties.AutomationId="diff.state" Text="{Binding ApprovalStateText, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                <TextBlock Text="Diff" FontWeight="SemiBold" />
            </DockPanel>
            <ItemsControl automation:AutomationProperties.AutomationId="diff.items" ItemsSource="{Binding DiffRows, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,2">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Old" Foreground="{StaticResource FaintBrush}" FontSize="10" />
                                <TextBlock Grid.Column="1" automation:AutomationProperties.AutomationId="diff.old-value" Text="{Binding OldValue}" FontFamily="Consolas" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="->" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold" Margin="0,2" />
                                <TextBlock Grid.Row="2" Text="New" Foreground="{StaticResource FaintBrush}" FontSize="10" />
                                <TextBlock Grid.Row="2" Grid.Column="1" automation:AutomationProperties.AutomationId="diff.new-value" Text="{Binding NewValue}" FontFamily="Consolas" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
