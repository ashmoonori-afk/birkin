<UserControl x:Class="Birkin.Native.App.Views.ResearchReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <UserControl.Resources>
        <ResourceDictionary Source="../Styles/ShellStyles.xaml" />
    </UserControl.Resources>
    <Grid>
        <RichTextBox x:Name="Report"
                     IsReadOnly="True"
                     IsDocumentEnabled="True"
                     BorderThickness="0"
                     Background="{StaticResource CardBrush}"
                     Foreground="{StaticResource TextBrush}"
                     FontSize="15"
                     Padding="12"
                     VerticalScrollBarVisibility="Auto"
                     automation:AutomationProperties.AutomationId="research.report"
                     automation:AutomationProperties.Name="리서치 보고서" />
        <Border x:Name="EmptyState" Style="{StaticResource EmptyStateStyle}"
                Background="{StaticResource RaisedBrush}"
                IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="아직 표시할 리서치 결과가 없습니다"
                           HorizontalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="대화에서 리서치를 요청하면 실제 결과가 여기에 표시됩니다."
                           HorizontalAlignment="Center" Margin="0,6,0,0"
                           Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
