<Window x:Class="Birkin.Native.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Birkin.Native.App.Views"
        Title="Birkin for Windows - Development Preview"
        Width="1500"
        Height="940"
        MinWidth="1100"
        MinHeight="700"
        ResizeMode="CanResize"
        Focusable="True"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary Source="Styles/ShellStyles.xaml" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#BD792B" Padding="12,5">
            <TextBlock Text="DEVELOPMENT PREVIEW"
                       Foreground="#160F08"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
        </Border>
        <views:WorkspaceSnapshotView x:Name="SnapshotView" Grid.Row="1" />
    </Grid>
</Window>
