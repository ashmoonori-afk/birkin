<Window x:Class="Birkin.Native.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Birkin.Native.App.Views"
        Title="Birkin for Windows - Development Preview"
        Width="1500"
        Height="940"
        MinWidth="1100"
        MinHeight="700"
        ResizeMode="CanResize"
        Focusable="True"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary Source="Styles/ShellStyles.xaml" />
    </Window.Resources>
    <views:WorkspaceSnapshotView x:Name="SnapshotView" />
</Window>
