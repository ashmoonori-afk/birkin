<Window x:Class="Birkin.Native.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Birkin.Native.App.Views"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Windows용 Birkin - 개발 프리뷰"
        Width="1500"
        Height="940"
        MinWidth="640"
        MinHeight="480"
        AllowDrop="True"
        PreviewDragEnter="WindowDragEntered"
        PreviewDragOver="WindowDragOver"
        PreviewDragLeave="WindowDragLeft"
        PreviewDrop="WindowDropped"
        ResizeMode="CanResize"
        Focusable="True"
        automation:AutomationProperties.AutomationId="workspace.window"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control"
                    Command="{x:Static views:WorkspaceSnapshotView.ToggleNavigationCommand}"
                    CommandTarget="{Binding ElementName=SnapshotView}" />
        <KeyBinding Key="B" Modifiers="Control+Shift"
                    Command="{x:Static views:WorkspaceSnapshotView.ToggleContextCommand}"
                    CommandTarget="{Binding ElementName=SnapshotView}" />
        <KeyBinding Key="F" Modifiers="Control+Shift"
                    Command="{x:Static views:WorkspaceSnapshotView.ToggleFocusCommand}"
                    CommandTarget="{Binding ElementName=SnapshotView}" />
        <KeyBinding Key="D" Modifiers="Control+Shift"
                    Command="{x:Static views:WorkspaceSnapshotView.ToggleDocumentFocusCommand}"
                    CommandTarget="{Binding ElementName=SnapshotView}" />
        <KeyBinding Key="D0" Modifiers="Control+Shift"
                    Command="{x:Static views:WorkspaceSnapshotView.ResetLayoutCommand}"
                    CommandTarget="{Binding ElementName=SnapshotView}" />
    </Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary Source="Styles/ShellStyles.xaml" />
    </Window.Resources>
    <Grid>
        <views:WorkspaceSnapshotView x:Name="SnapshotView" />
        <Border x:Name="DropOverlay"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Margin="12"
                Background="{StaticResource DropOverlayBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="12"
                automation:AutomationProperties.AutomationId="import.drop-overlay"
                automation:AutomationProperties.Name="업무 문서 가져오기 영역">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE8B7;"
                           Style="{StaticResource GlyphStyle}"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="DropOverlayText"
                           Margin="0,12,0,0"
                           Text="파일 하나를 안전한 작업공간으로 가져오세요"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="17"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
