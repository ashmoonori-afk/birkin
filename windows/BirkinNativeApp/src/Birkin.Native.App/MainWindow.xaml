<Window x:Class="Birkin.Native.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Birkin.Native.App.Views"
        Title="Birkin for Windows - Development Preview"
        Width="760"
        Height="720"
        MinWidth="560"
        MinHeight="520"
        ResizeMode="CanResize"
        Focusable="True"
        Background="#0C1016"
        Foreground="#F4F7FA"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#C8872D" Padding="16,10">
            <TextBlock Text="DEVELOPMENT PREVIEW"
                       Foreground="#15100A"
                       FontSize="13"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="34,28">
            <StackPanel MaxWidth="680">
                <TextBlock Text="Birkin workspace"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBlock Text="Read-only Python-owned session projection"
                           Foreground="#8E99A8"
                           FontSize="14"
                           Margin="0,0,0,24" />
                <views:WorkspaceSnapshotView x:Name="SnapshotView" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
