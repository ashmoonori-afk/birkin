#!/bin/sh
# birkin: package versions are release metadata, not commit counters.
#
# Development commits must never rewrite or stage version files. Update
# pyproject.toml and birkin/__init__.py explicitly when preparing a release;
# release.yml validates that the release tag matches that chosen version.
#
# Install (from the repo root):
#   cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
exit 0
